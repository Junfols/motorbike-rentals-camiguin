# Copy to .env for local PostgreSQL testing or set these in Render -> Environment

# Neon PostgreSQL connection string (leave blank locally to use SQLite motoride.db)
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-host.region.aws.neon.tech/neondb?sslmode=require

# Long random string for keeping sessions signed across server restarts
SECRET_KEY=replace-with-a-long-random-secret-string

# Initial Main Admin password (only used on first empty database setup; default is admin1234)
ADMIN_PASSWORD=admin1234
